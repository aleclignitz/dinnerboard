# Fill these in locally for testing scripts/*.mjs with `node --env-file=.env scripts/plan-draft.mjs`.
# In GitHub Actions, these are set as repository secrets/variables instead - never commit a real .env.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=
PLAN_TIME_ZONE=America/Chicago
PLAN_GUIDELINES=
PLAN_MAX_COOK_MINUTES=45
STORE_NAME=Walmart pickup
ORDER_METHOD=delivery
PICKUP_WINDOW=1-4 PM
SUBSTITUTION_RULES=Store-brand substitutions are preferred.
TOM_THUMB_ZIP=75214
TOM_THUMB_STORE_ADDRESS=6333 E Mockingbird Ln
# Not needed locally if scripts/_tomthumb-storageState.json exists (see
# `npm run capture-tomthumb-session`). In GitHub Actions this must be set as
# the TOM_THUMB_STORAGE_STATE secret (paste the full JSON file contents).
TOM_THUMB_STORAGE_STATE=
